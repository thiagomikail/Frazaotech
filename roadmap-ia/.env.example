# Mesma chave do Bancada — não precisa criar outra.
GOOGLE_API_KEY=

# Pode ser o MESMO banco do Bancada: tudo aqui vive no schema `roadmap_ia`.
# Use o pooler do Supabase (porta 6543), nunca o host direto (IPv6 puro).
DATABASE_URL=
# Opcional: conexão de sessão (5432) só pro `npm run db:criar`.
DIRECT_URL=

# Sua chave do /admin. Mínimo 12 caracteres. Gere com: openssl rand -hex 16
ADMIN_CHAVE=

# Opcional
TETO_DIARIO=150
MODELO_ANALISE=

# E-mail do relatório (único jeito de o aluno ver o resultado).
# Gmail: Conta Google → Segurança → Verificação em 2 etapas → Senhas de app.
SMTP_USER=
SMTP_PASS=
# Opcionais
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_DE=
EMAIL_COPIA=
EMAIL_RESPONDER=
