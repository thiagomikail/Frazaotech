# ---------------------------------------------------------------- banco
# Supabase. O host direto (db.<ref>.supabase.co) e IPv6 puro e as funcoes da
# Vercel sao IPv4 — runtime usa o POOLER. DDL (db push) usa a 5432.
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# -------------------------------------------------------------- hotmart
# Painel Hotmart > Ferramentas > Credenciais de API (perfil de Desenvolvedor).
HOTMART_CLIENT_ID=""
HOTMART_CLIENT_SECRET=""
# O "Basic" pronto que a Hotmart mostra junto das credenciais. Se vazio, o
# cliente monta sozinho a partir de id:secret.
HOTMART_BASIC=""
# Hottok: aba Webhook > Autenticacao. Valida quem esta chamando /api/webhook.
HOTMART_HOTTOK=""
# sandbox | producao
HOTMART_AMBIENTE="producao"

# ---------------------------------------------------------------- acesso
# Login do painel. Ao contrario de um app domestico, aqui tem dado pessoal de
# terceiros (CPF, telefone): obscuridade de URL nao serve, precisa de senha.
PAINEL_EMAIL="voce@exemplo.com"
PAINEL_SENHA_HASH=""   # gerado por: npm run gerar:segredos
SESSAO_SEGREDO=""      # gerado por: npm run gerar:segredos

# ------------------------------------------------------------------ cron
CRON_SECRET=""         # gerado por: npm run gerar:segredos
