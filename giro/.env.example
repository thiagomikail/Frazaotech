# Postgres (Supabase, Neon, Prisma Postgres...). DIRECT_URL so e necessario
# quando o runtime usa pooler e o CLI precisa da conexao direta para DDL.
DATABASE_URL="postgresql://usuario:senha@host:5432/giro"
DIRECT_URL=

# Assina o cookie de sessao. Gere com: openssl rand -base64 32
SEGREDO_SESSAO=

# https://openrouter.ai/keys — NUNCA prefixe com NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODELO="anthropic/claude-sonnet-4.5"

# URL publica do app (OpenRouter pede para atribuicao de ranking)
GIRO_URL="http://localhost:3000"

# Beta: libera os recursos do plano Pro para todo mundo sem apagar a regua
# de cobranca. Vire para "false" no dia de comecar a cobrar.
BETA_LIBERADO="true"

# Protege /api/cron/diagnostico, que custa token a cada execucao.
# Gere com: openssl rand -hex 32
CRON_SECRET=
