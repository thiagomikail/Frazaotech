{
  "name": "giro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --config prisma7.config.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:sincronizar": "prisma db push --config prisma7.config.ts",
    "db:estudio": "prisma studio --config prisma7.config.ts",
    "db:semear": "tsx prisma/seed.ts",
    "gerar:client": "prisma generate --config prisma7.config.ts",
    "verificar": "tsc --noEmit",
    "olhar:sinais": "tsx --conditions=react-server scripts/olhar-sinais.ts",
    "testar": "node scripts/testar.mjs",
    "testar:ia": "tsx --conditions=react-server scripts/testar-ia.ts",
    "servir": "sh scripts/servir.sh",
    "manual": "node scripts/capturar-telas.mjs && node scripts/converter-telas.mjs && node scripts/gerar-manual.mjs",
    "manual:telas": "node scripts/capturar-telas.mjs",
    "manual:montar": "node scripts/converter-telas.mjs && node scripts/gerar-manual.mjs",
    "manual:olhar": "node scripts/olhar-manual.mjs",
    "manual:video": "cd manual/video && npm install --no-audit --no-fund && mkdir -p public/telas && cp ../telas/*.png public/telas/ && node render.mjs",
    "manual:conferir": "node scripts/conferir-videos.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^1.38.0",
    "next": "16.3.4",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}